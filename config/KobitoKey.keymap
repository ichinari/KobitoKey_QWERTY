#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_kana {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG1>;
        };

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG2>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    macros {
        screenshot_tool: snapShot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_SHIFT &kp N5>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_SHIFT>;

            label = "SNAPSHOT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W      &kp E       &kp R      &kp T         &kp Y      &kp U       &kp I          &kp O              &kp P
&kp A      &kp S      &kp D       &kp F      &kp G         &kp H      &kp J       &kp K          &kp L              &kp SEMI
&kp Z      &kp X      &kp C       &kp V      &kp B         &kp N      &kp M       &kp COMMA      &kp DOT            &kp SLASH
&kp LSHFT  &kp LCTRL  &lt 1 INT4  &kp SPACE  &mt LGUI TAB  &kp ENTER  &lt 2 INT5  &kp BACKSPACE  &mt RIGHT_ALT ESC  &kp LEFT_SHIFT
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp N1      &kp N2     &kp N3            &kp N4             &kp N5         &kp N6          &kp N7                &kp N8      &kp N9     &kp N0
&kp MINUS   &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp LEFT_ARROW  &kp DOWN              &kp UP      &kp RIGHT  &kp SINGLE_QUOTE
&none       &none      &none             &none              &none          &none           &none                 &none       &none      &none
&kp LSHIFT  &none      &none             &none              &none          &none           &mt LEFT_GUI LA(TAB)  &kp DELETE  &none      &kp LEFT_SHIFT
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&none         &none      &kp K_MUTE  &kp C_VOL_DN  &kp C_VOLUME_UP  &kp C_SNAPSHOT  &none          &none             &none          &none
&bt BT_SEL 0  &kp LG(Z)  &kp LG(X)   &kp LG(C)     &kp LG(V)        &kp LC(LEFT)    &kp LC(DOWN)   &kp LC(UP_ARROW)  &kp LC(RIGHT)  &none
&bt BT_SEL 1  &trans     &trans      &trans        &none            &kp RCTRL       &kp RC(SPACE)  &kp RIGHT_SHIFT   &kp RIGHT_GUI  &trans
&bt BT_SEL 2  &trans     &trans      &trans        &trans           &none           &trans         &trans            &trans         &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans     &trans     &trans     &trans  &mkp MB5  &none     &none     &none     &trans
&kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &trans  &mkp MB4  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans     &trans     &trans     &trans     &trans  &trans    &trans    &trans    &trans    &trans
&none      &trans     &none      &to 0      &none   &trans    &trans    &trans    &none     &none
            >;
        };
    };
};
